# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CREDENTIALS_ENCRYPTION_KEY=

# AI — Step 5 crawler (embeddings + niche summary), also used for Boss AI in Step 7.
# build.nvidia.com → API Keys → Generate. Single-key setup: same key covers everything.
NVIDIA_API_KEY=
# Optional, once you have more than one NVIDIA key: dedicated pools so background work
# (onboarding crawl) can never starve live chat/article-revise, and vice versa — each pool is
# comma-separated, round-robins across its keys, and falls back to NVIDIA_API_KEY above when
# empty. See lib/ai/nvidiaKeys.ts and agent-server/.env.example's NVIDIA_API_KEYS_BG.
# NVIDIA_API_KEYS_CHAT=nvapi-xxx,nvapi-yyy
# NVIDIA_API_KEYS_BG=nvapi-zzz
EMBEDDINGS_PROVIDER=nvidia
LLM_PROVIDER=nvidia
CRAWL_PAGE_LIMIT=15

# agent-server (Railway) base URL — used to enqueue the FULL background site crawl after
# onboarding completes (the "crawler" agent; see agent-server/src/agents/crawler.ts).
AGENT_SERVER_URL=

# Shared secret for agent-server's POST /jobs/:type. Optional, but that endpoint is a public
# URL that spends real model credits: generate any long random string and set the SAME value
# here (Vercel) and in Railway as AGENT_SERVER_TOKEN. Unset on either side = endpoint stays open.
# The same token also authenticates the brain's routes (GET /brain/registry, POST /brain/tasks).
AGENT_SERVER_TOKEN=

# Does the chat route orders through the BRAIN (registry -> intent engine -> task), or through
# the old direct-enqueue path? "1" on, "0" off. Leave it UNSET and it is ON — everywhere,
# production included: "ek dimaag" is the whole architecture (MASTER_PLAN §4, §18.6), and this
# is only an emergency kill switch now, not a permanent second decision-maker.
#
# With it on, the chat needs AGENT_SERVER_URL to reach the brain: if the brain cannot be
# reached, an order is REFUSED with "Team abhi reachable nahi hai" — it is never quietly sent
# down the old path, because two systems creating work is two articles and two bills.
# Questions and greetings still work either way. Requires migration 017 (conversation_state).
BRAIN_ENABLED=

# §18.2 item 1 — a dedicated-inference provider ahead of NIM's shared free queue, for the one
# chat call a customer watches token-by-token. Inert unless set (docs/MANUAL_STEPS.md item 12).
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
#
# Optional second (third, ...) account on the SAME provider, tried in order before falling to
# the next provider — for when the first free-tier key's daily/per-minute cap runs out before
# the day is over. Does nothing for a Groq outage (every key on Groq fails alike); that is what
# falling through to Cerebras / NIM already covers.
# GROQ_API_KEY_2=
# CEREBRAS_API_KEY_2=

# Google — Search Console + Analytics 4 (+ optionally Business Profile). This is what lets the
# agents plan from measured searches instead of guesses; see /app/connect for the setup steps.
# console.cloud.google.com -> new project -> enable "Search Console API", "Google Analytics
# Admin API" and "Google Analytics Data API" -> Credentials -> OAuth client ID (Web
# application) -> Authorized redirect URI: https://YOUR-APP/api/integrations/google/callback
# Leave these empty and the Google card simply shows the setup instructions instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed when the callback URL is not "<this deployment's origin>/api/integrations/google/callback"
# (Google matches it byte-for-byte, so preview deployments need this pinned to the real one).
GOOGLE_REDIRECT_URI=
