# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CREDENTIALS_ENCRYPTION_KEY=

# AI — Step 5 crawler (embeddings + niche summary), also used for Boss AI in Step 7.
# build.nvidia.com → API Keys → Generate. Same key covers both embeddings + chat.
NVIDIA_API_KEY=
EMBEDDINGS_PROVIDER=nvidia
LLM_PROVIDER=nvidia
CRAWL_PAGE_LIMIT=15

# agent-server (Railway) base URL — used to enqueue the FULL background site crawl after
# onboarding completes (the "crawler" agent; see agent-server/src/agents/crawler.ts).
AGENT_SERVER_URL=

# Shared secret for agent-server's POST /jobs/:type. Optional, but that endpoint is a public
# URL that spends real model credits: generate any long random string and set the SAME value
# here (Vercel) and in Railway as AGENT_SERVER_TOKEN. Unset on either side = endpoint stays open.
AGENT_SERVER_TOKEN=

# Google — Search Console + Analytics 4 (+ optionally Business Profile). This is what lets the
# agents plan from measured searches instead of guesses; see /app/connect for the setup steps.
# console.cloud.google.com -> new project -> enable "Search Console API", "Google Analytics
# Admin API" and "Google Analytics Data API" -> Credentials -> OAuth client ID (Web
# application) -> Authorized redirect URI: https://YOUR-APP/api/integrations/google/callback
# Leave these empty and the Google card simply shows the setup instructions instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed when the callback URL is not "<this deployment's origin>/api/integrations/google/callback"
# (Google matches it byte-for-byte, so preview deployments need this pinned to the real one).
GOOGLE_REDIRECT_URI=
