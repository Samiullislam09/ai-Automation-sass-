# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CREDENTIALS_ENCRYPTION_KEY=

# AI — Step 5 crawler (embeddings + niche summary), also used for Boss AI in Step 7.
# build.nvidia.com → API Keys → Generate. Same key covers both embeddings + chat.
NVIDIA_API_KEY=
EMBEDDINGS_PROVIDER=nvidia
LLM_PROVIDER=nvidia
CRAWL_PAGE_LIMIT=15

# agent-server (Railway) base URL — used to enqueue the FULL background site crawl after
# onboarding completes (the "crawler" agent; see agent-server/src/agents/crawler.ts).
AGENT_SERVER_URL=
