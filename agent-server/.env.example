PORT=4000

# Postgres connection string used as the job queue (pg-boss) — NOT Redis.
# Supabase dashboard: Project Settings -> Database -> Connection string -> URI.
# (Switched from Upstash Redis/BullMQ after hitting Upstash's free-tier 500k
# request/month cap — see db.ts for the full reasoning.)
DATABASE_URL=

# Same Supabase project as the main app — Project Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated origins allowed to open the Socket.io connection (your Next.js app).
CORS_ORIGIN=http://localhost:3000

# DataForSEO — Step 9 (Keyword Finder). Dashboard: app.dataforseo.com -> API access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# NVIDIA NIM — Writer agent (Step 11). TEMPORARY stand-in for a real Frontier-tier
# model (DeepSeek/Gemini) — see the comment in src/lib/writer.ts before production.
NVIDIA_API_KEY=
# WRITER_PROVIDER=nvidia   # default; set to "deepseek" once that's implemented

# Full-site crawler agent — max pages per full crawl (see agents/crawler.ts).
# CRAWL_PAGE_LIMIT=300

# Base URL of the Next.js app (e.g. https://yourapp.vercel.app). Lets the boss agent ask it
# to refresh Google Search Console / GA4 data before planning topics, so a scheduled run
# plans against this week's numbers. Needs AGENT_SERVER_TOKEN set on BOTH sides; without
# both, that refresh is skipped and planning falls back to the site crawl.
WEB_APP_URL=

# Per-tenant daily job caps — the budget guard, one per agent. Defaults (see
# src/config/caps.ts): boss 25, keyword 150, writer 40, social 60, seo 40, leads 60,
# crawler 5. Retries do not count; only first attempts do. Raise any of them here without
# touching code. The writer is the expensive one (~90s of a 30B model per article) and the
# crawler does up to ~300 embedding calls per run, so raise those two deliberately.
# DAILY_CAP_BOSS=25
# DAILY_CAP_WRITER=40
# DAILY_CAP_CRAWLER=5

# NVIDIA requests per minute this server allows itself. build.nvidia.com shows the account's
# ceiling (free tier: "Up to 40 rpm") and the API returns NO quota headers, so nothing can be
# measured after the fact — the limit has to be respected on our side. Default 30, not 40:
# the limit belongs to the API KEY, and Vercel calls NVIDIA with the same key for chat and
# article revisions, so this leaves ~10/min for the path a human is waiting on.
# The crawler is what actually reaches it: ~300 pages, one embedding call each.
# NVIDIA_RPM=30

# How long the keyword table stays on screen before Mr. Writer starts on the recommended one
# (agent-server/src/agents/keyword.ts). The floor is 5s, but the dashboard polls every 4s, so
# anything near that means most users never see the table at all — 20s is the default so a
# poll landing late still leaves time to read four columns and click.
# KEYWORD_CHOICE_SECONDS=20
