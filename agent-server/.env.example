PORT=4000

# Upstash — Redis tab (NOT the REST API tab) on your database's detail page.
# Must start with rediss:// (double s = TLS) for ioredis/BullMQ.
REDIS_URL=

# Same Supabase project as the main app — Project Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated origins allowed to open the Socket.io connection (your Next.js app).
CORS_ORIGIN=http://localhost:3000

# DataForSEO — Step 9 (Keyword Finder). Dashboard: app.dataforseo.com -> API access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
